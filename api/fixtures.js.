// api/fixtures.js
import chromium from "chrome-aws-lambda";
import * as cheerio from "cheerio";

export default async function handler(req, res) {
  try {
    // Launch headless browser
    const browser = await chromium.puppeteer.launch({
      args: chromium.args,
      defaultViewport: chromium.defaultViewport,
      executablePath: await chromium.executablePath,
      headless: true,
    });

    const page = await browser.newPage();
    const url = "https://www.betexplorer.com/football/";

    await page.goto(url, { waitUntil: "networkidle2", timeout: 30000 });

    const html = await page.content();
    const $ = cheerio.load(html);

    let fixtures = [];

    $(".table-main tbody tr").each((i, el) => {
      const home = $(el).find(".table-participant a").first().text().trim();
      const away = $(el).find(".table-participant a").last().text().trim();
      const time = $(el).find("td.kickoff").text().trim();

      if (home && away) {
        fixtures.push({
          home,
          away,
          time,
        });
      }
    });

    await browser.close();
    res.status(200).json({ fixtures });
  } catch (error) {
    console.error(error);
    res.status(500).json({ error: "Failed to fetch fixtures", details: error.message });
  }
}
