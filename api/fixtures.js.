// api/fixtures.js
import axios from 'axios';
import cheerio from 'cheerio';

export default async function handler(req, res) {
  try {
    if (req.method !== 'GET') {
      return res.status(405).json({ error: 'Method Not Allowed' });
    }

    const country = (req.query.country || 'england').toLowerCase();
    const league = (req.query.league || 'premier-league').toLowerCase();

    const url = `https://www.betexplorer.com/soccer/${country}/${league}/fixtures/`;

    const { data } = await axios.get(url, {
      headers: {
        'User-Agent': 'Mozilla/5.0',
        Accept: 'text/html',
      },
    });

    const $ = cheerio.load(data);
    const fixtures = [];

    $('table.table-main tr').each((_, tr) => {
      const teams = [];
      $(tr)
        .find('a')
        .each((_, a) => {
          const t = $(a).text().trim();
          if (t && /[A-Za-z]/.test(t)) teams.push(t);
        });

      if (teams.length >= 2) {
        fixtures.push({ home: teams[0], away: teams[1] });
      }
    });

    return res.status(200).json({ league: `${country}/${league}`, count: fixtures.length, fixtures });
  } catch (error) {
    console.error(error);
    return res.status(500).json({ error: 'Failed to fetch fixtures', details: error.message });
  }
}
